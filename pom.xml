<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
    </parent>

    <groupId>nl.timtwiest</groupId>
    <artifactId>simple-java-api</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <organization>
        <name>Tim Twiest</name>
        <url>https://timtwiest.nl/</url>
    </organization>
    <inceptionYear>2024</inceptionYear>
    <developers>
        <developer>
            <name>Tim Twiest</name>
            <email>hello@timtwiest.nl</email>
        </developer>
    </developers>
    <description>A contract-first REST API built with Spring Boot, OpenAPI, and PostgreSQL</description>
    <scm>
        <url>https://github.com/timtwiest/simple-java-api</url>
    </scm>

    <properties>
        <!--  Maven Project/Build Settings  -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.source>25</maven.compiler.source>
        <java.version>25</java.version>

        <!-- Keep the JUnit Platform aligned with the current Cucumber engine. -->
        <junit-jupiter.version>5.14.2</junit-jupiter.version>

    </properties>

    <modules>
        <module>simple-java-api-api</module>
        <module>simple-java-api-app</module>
    </modules>

</project>
